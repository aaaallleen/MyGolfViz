{
  "name": "flightscope-analytics",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run dev -w @fsa/web",
    "dev:local": "npm run dev:local -w @fsa/web",
    "build:public": "npm run build:public -w @fsa/web",
    "build:local": "npm run build:local -w @fsa/web",
    "local": "npm run build:local && uv run --project apps/api mygolfviz-api --static-dir apps/web/dist-local",
    "api:test": "uv run --project apps/api pytest apps/api/tests -q",
    "verify:public": "node scripts/verify-public-build.mjs apps/web/dist",
    "build:e2e": "PAGES_BASE=/fsa-e2e/ npm run build:public",
    "preview:e2e": "PAGES_BASE=/fsa-e2e/ npm run preview -w @fsa/web -- --port 4173 --strictPort",
    "e2e": "playwright test",
    "ci:public": "npm run typecheck && npm test && npm run build:public && npm run verify:public && npm run e2e",
    "api:types": "uv run --project apps/api python -m mygolfviz_api.openapi_dump > apps/web/src/local/openapi.json && npx openapi-typescript apps/web/src/local/openapi.json -o apps/web/src/local/api-types.ts",
    "verify:local": "node scripts/verify-local-build.mjs apps/web/dist-local",
    "e2e:local": "playwright test -c playwright.local.config.ts",
    "ci:local": "npm run api:test && npm run build:local && npm run verify:local && npm run e2e:local"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
